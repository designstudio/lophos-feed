# Clerk — https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Dedicated server-only key for encrypted /api/feed pagination cursors.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FEED_CURSOR_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/feed
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Supabase — https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-large-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_TIMEOUT_MS=300000

# Ollama/Gemma — manual editorial processing only (not used by cron)
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT_MS=600000
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CLUSTER_DELAY_MS=0

# RSS Feed Collection — https://github.com/designstudio/lophos-feed
# Secret token for /api/rss/ingest endpoint authentication
RSS_INGEST_SECRET=your_secret_token_here

# Application URL (used by cron jobs to call internal endpoints)
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Next.js Server Actions
# Reuse the same base64 AES key for every production build/runtime in self-hosted Docker deploys.
# Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# PandaScore — https://pandascore.co (esports matches)
PANDASCORE_API_KEY=sua_key_aqui

# TMDB — https://themoviedb.org (series episodes)
TMDB_API_KEY=eyJ...

# Resend â€” https://resend.com (receiving emails via webhook)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
# Article correction reports (outbound email)
ARTICLE_REPORT_EMAIL_FROM=Lophos <reports@mail.lophos.space>
ARTICLE_REPORT_EMAIL_TO=hello@mail.lophos.space
